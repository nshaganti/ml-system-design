# --- Data (huge; download separately, never commit) ---
# Ignore everything under data/ (datasets are downloaded, not versioned),
# but keep a README there so the folder + instructions are tracked.
data/*
!data/README.md

# --- Python noise ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- ML artifacts (large binaries; MLflow regenerates them) ---
*.pth

# --- MLflow local tracking store (derived experiment state, not source) ---
# Anchored anywhere in the tree (e.g. phase1/mlruns/).
**/mlruns/

# --- Local run outputs ---
# NOTE: phase*/results.json ARE committed on purpose -- they are the source of
# truth for the scoreboard (scripts/build_results.py) and the HTML report, and
# they let CI verify the docs aren't stale without needing the dataset.

# --- macOS / editor junk ---
.DS_Store

# --- Env / secrets ---
.env
